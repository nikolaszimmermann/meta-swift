From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolas Zimmermann <nzimmermann@igalia.com>
Date: Sat, 21 Nov 2026 00:28:56 +0100
Subject: [PATCH] lldb: Only install the copied clang resource directory with
 Swift support

lib/lldb/clang is only populated by the copy-clang-resource-dir target,
which exists only when LLDB_ENABLE_SWIFT_SUPPORT is on. With Swift support
off, installing lldb fails with "file INSTALL cannot find .../lib/lldb/clang".
Guard the install rule the same way.

Upstream-Status: Pending
Signed-off-by: Nikolas Zimmermann <nzimmermann@igalia.com>
---
 lldb/source/API/CMakeLists.txt | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/lldb/source/API/CMakeLists.txt b/lldb/source/API/CMakeLists.txt
index fb6434fa1..7a5dd7084 100644
--- a/lldb/source/API/CMakeLists.txt
+++ b/lldb/source/API/CMakeLists.txt
@@ -448,12 +448,14 @@ endif()
 add_dependencies(liblldb ${copy-clang-resource-dir} ${copy-swift-resource-dir})
 endif()
 
+if(LLDB_ENABLE_SWIFT_SUPPORT)
 install(
   CODE "file(MAKE_DIRECTORY ${lib_dir}/lldb)")
 
 install(
   DIRECTORY "${lib_dir}/lldb/clang"
   DESTINATION lib${LLVM_LIBDIR_SUFFIX}/lldb/)
+endif()
 
 if(LLDB_ENABLE_SWIFT_SUPPORT)
 if(LLDB_BUILT_STANDALONE)
