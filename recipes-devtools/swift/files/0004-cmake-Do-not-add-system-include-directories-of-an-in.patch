From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolas Zimmermann <nzimmermann@igalia.com>
Date: Sat, 21 Nov 2026 19:10:00 +0100
Subject: [PATCH] cmake: Do not add system include directories of an installed
 LLVM

A standalone build against an LLVM and Clang installed into the system
prefix of a sysroot (e.g. a Yocto/OpenEmbedded SDK sysroot) gets the
system include directory as LLVM_INCLUDE_DIRS and CLANG_INCLUDE_DIRS.
Passing it with -I moves it ahead of the builtin headers of the compiler.
CMake drops it again for C and C++, but not for Swift, so the Clang
importer picks up the C library <tgmath.h> instead of the Clang one and
fails to build the SwiftGlibc module.

The same applies to the include directories of an installed libdispatch
package (dispatch_DIR). Leave out include directories that are implicit
include directories of the C or C++ compiler.

Upstream-Status: Pending
Signed-off-by: Nikolas Zimmermann <nzimmermann@igalia.com>
---
 cmake/modules/Libdispatch.cmake            |  3 +++
 cmake/modules/SwiftSharedCMakeConfig.cmake | 33 +++++++++++++++++++++++++++++++--
 2 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/cmake/modules/Libdispatch.cmake b/cmake/modules/Libdispatch.cmake
--- a/cmake/modules/Libdispatch.cmake
+++ b/cmake/modules/Libdispatch.cmake
@@ -56,6 +56,9 @@
   foreach(target dispatch BlocksRuntime)
     get_target_property(include_directories ${target} INTERFACE_INCLUDE_DIRECTORIES)
     if(include_directories)
+      swift_filter_implicit_include_dirs(include_directories ${include_directories})
+    endif()
+    if(include_directories)
       list(APPEND SWIFT_LIBDISPATCH_INCLUDE_DIRECTORIES ${include_directories})
     endif()
   endforeach()
diff --git a/cmake/modules/SwiftSharedCMakeConfig.cmake b/cmake/modules/SwiftSharedCMakeConfig.cmake
--- a/cmake/modules/SwiftSharedCMakeConfig.cmake
+++ b/cmake/modules/SwiftSharedCMakeConfig.cmake
@@ -2,6 +2,26 @@
 
 include(CheckCXXCompilerFlag)
 
+# An LLVM installed into the system prefix of a sysroot has its headers in a
+# system include directory of the compiler. Adding it with -I would move it
+# ahead of the compiler's builtin headers, which breaks e.g. <tgmath.h> in
+# the Swift Clang importer, so leave such directories out.
+function(swift_filter_implicit_include_dirs out_var)
+  set(implicit)
+  foreach(dir ${CMAKE_C_IMPLICIT_INCLUDE_DIRECTORIES} ${CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES})
+    get_filename_component(dir "${dir}" REALPATH)
+    list(APPEND implicit "${dir}")
+  endforeach()
+  set(result)
+  foreach(dir ${ARGN})
+    get_filename_component(real_dir "${dir}" REALPATH)
+    if(NOT real_dir IN_LIST implicit)
+      list(APPEND result "${dir}")
+    endif()
+  endforeach()
+  set(${out_var} "${result}" PARENT_SCOPE)
+endfunction()
+
 macro(swift_common_standalone_build_config_llvm product)
   option(LLVM_ENABLE_WARNINGS "Enable compiler warnings." ON)
 
@@ -169,9 +189,17 @@
     "${PACKAGE_VERSION_MAJOR}.${PACKAGE_VERSION_MINOR}" CACHE STRING
     "Version number that will be placed into the libclang library , in the form XX.YY")
 
-  foreach(INCLUDE_DIR ${LLVM_INCLUDE_DIRS})
+  swift_filter_implicit_include_dirs(_swift_llvm_include_dirs ${LLVM_INCLUDE_DIRS})
+  foreach(INCLUDE_DIR ${_swift_llvm_include_dirs})
     include_directories(${INCLUDE_DIR})
   endforeach ()
+  # TableGen does not search the compiler's include directories, it still
+  # needs the filtered ones for e.g. llvm/Option/OptParser.td.
+  foreach(INCLUDE_DIR ${LLVM_INCLUDE_DIRS})
+    if(NOT INCLUDE_DIR IN_LIST _swift_llvm_include_dirs)
+      list(APPEND LLVM_TABLEGEN_FLAGS "-I${INCLUDE_DIR}")
+    endif()
+  endforeach()
 
   # *NOTE* if we want to support separate Clang builds as well as separate LLVM
   # builds, the clang build directory needs to be added here.
@@ -200,7 +228,8 @@
     set(${product}_NATIVE_CLANG_TOOLS_PATH "${LLVM_TOOLS_BINARY_DIR}")
   endif()
 
-  include_directories(${CLANG_INCLUDE_DIRS})
+  swift_filter_implicit_include_dirs(_swift_clang_include_dirs ${CLANG_INCLUDE_DIRS})
+  include_directories(${_swift_clang_include_dirs})
 endmacro()
 
 macro(swift_common_standalone_build_config_cmark product)
