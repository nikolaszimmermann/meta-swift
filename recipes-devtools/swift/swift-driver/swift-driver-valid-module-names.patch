From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolas Zimmermann <nzimmermann@igalia.com>
Date: Sun, 22 Nov 2026 19:59:36 +0100
Subject: [PATCH] cmake: Give the executables valid Swift module names

CMake uses the target name as the Swift module name. The legacy C++
driver accepts swift-help and friends, but swift-driver rejects them:

  error: module name "swift-help" is not a valid identifier

Set Swift_MODULE_NAME to the name with underscores.

Upstream-Status: Pending
---
 Sources/swift-build-sdk-interfaces/CMakeLists.txt | 1 +
 Sources/swift-driver/CMakeLists.txt               | 1 +
 Sources/swift-help/CMakeLists.txt                 | 1 +
 3 files changed, 3 insertions(+)

diff --git a/Sources/swift-build-sdk-interfaces/CMakeLists.txt b/Sources/swift-build-sdk-interfaces/CMakeLists.txt
index 001d57f..84f0a9d 100644
--- a/Sources/swift-build-sdk-interfaces/CMakeLists.txt
+++ b/Sources/swift-build-sdk-interfaces/CMakeLists.txt
@@ -8,6 +8,7 @@
 
 add_executable(swift-build-sdk-interfaces
   main.swift)
+set_target_properties(swift-build-sdk-interfaces PROPERTIES Swift_MODULE_NAME swift_build_sdk_interfaces)
 target_link_libraries(swift-build-sdk-interfaces PUBLIC
   SwiftDriver
   SwiftDriverExecution)
diff --git a/Sources/swift-driver/CMakeLists.txt b/Sources/swift-driver/CMakeLists.txt
index a55f7fe..a2225e8 100644
--- a/Sources/swift-driver/CMakeLists.txt
+++ b/Sources/swift-driver/CMakeLists.txt
@@ -8,6 +8,7 @@
 
 add_executable(swift-driver
   main.swift)
+set_target_properties(swift-driver PROPERTIES Swift_MODULE_NAME swift_driver)
 target_link_libraries(swift-driver PUBLIC
   SwiftDriver
   SwiftDriverExecution)
diff --git a/Sources/swift-help/CMakeLists.txt b/Sources/swift-help/CMakeLists.txt
index cba8992..3716515 100644
--- a/Sources/swift-help/CMakeLists.txt
+++ b/Sources/swift-help/CMakeLists.txt
@@ -8,6 +8,7 @@
 
 add_executable(swift-help
   main.swift)
+set_target_properties(swift-help PROPERTIES Swift_MODULE_NAME swift_help)
 target_link_libraries(swift-help PUBLIC
   SwiftOptions
   ArgumentParser
