From: Patrick Griffis
Subject: [PATCH] swift-driver-exclude-vendored-from-install

Taken from the WebKit container SDK (github.com/Igalia/webkit-container-sdk,
images/wkdev_sdk/jhbuild/patches).

Upstream-Status: Inappropriate [packaging]
Signed-off-by: Nikolas Zimmermann <nzimmermann@igalia.com>
---
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -56,7 +56,8 @@
   message("-- Vending swift-argument-parser")
   FetchContent_Declare(ArgumentParser
     GIT_REPOSITORY https://github.com/apple/swift-argument-parser
-    GIT_TAG 1.5.1)
+    GIT_TAG 1.5.1
+    EXCLUDE_FROM_ALL)
   list(APPEND VendoredDependencies ArgumentParser)
 endif()
 
@@ -79,7 +80,8 @@
   message("-- Vending swift-tools-support-core")
   FetchContent_Declare(ToolsSupportCore
     GIT_REPOSITORY https://github.com/apple/swift-tools-support-core
-    GIT_TAG main)
+    GIT_TAG main
+    EXCLUDE_FROM_ALL)
   list(APPEND VendoredDependencies ToolsSupportCore)
 endif()
 
