From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolas Zimmermann <nzimmermann@igalia.com>
Date: Sun, 22 Nov 2026 14:52:39 +0100
Subject: [PATCH] clang: Prefer <sysroot>/usr for GCC in usrmerge sysroots

In a usrmerge sysroot <sysroot>/lib is a link to usr/lib, and the GCC
installation is found through it. The libstdc++ include directory is
then lib/<triple>/<version>/../../../include, which resolves to
<sysroot>/usr/include on disk but to <sysroot>/include when normalized
lexically. The Swift compiler and LLVM's redirecting file system
normalize lexically, so the libstdc++ module map Swift injects there
does not cover the headers clang actually reads.

Search <sysroot>/usr before <sysroot> when <sysroot>/lib is a link.

Upstream-Status: Pending
---
 clang/lib/Driver/ToolChains/Gnu.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/clang/lib/Driver/ToolChains/Gnu.cpp b/clang/lib/Driver/ToolChains/Gnu.cpp
index 587996e..6a37aba 100644
--- a/clang/lib/Driver/ToolChains/Gnu.cpp
+++ b/clang/lib/Driver/ToolChains/Gnu.cpp
@@ -28,6 +28,7 @@
 #include "llvm/ADT/Twine.h"
 #include "llvm/Option/ArgList.h"
 #include "llvm/Support/CodeGen.h"
+#include "llvm/Support/FileSystem.h"
 #include "llvm/Support/Path.h"
 #include "llvm/Support/VirtualFileSystem.h"
 #include "llvm/TargetParser/RISCVISAInfo.h"
@@ -2171,8 +2172,16 @@ void Generic_GCC::GCCInstallationDetector::init(
   } else {
     // If we have a SysRoot, try that first.
     if (!D.SysRoot.empty()) {
-      Prefixes.push_back(D.SysRoot);
+      // In a usrmerge sysroot <sysroot>/lib links to usr/lib. Look in
+      // <sysroot>/usr first then, or the include paths derived from the GCC
+      // installation (lib/<triple>/<version>/../../../include) point to
+      // <sysroot>/include once normalized lexically, which does not exist.
+      bool UsrMerged = llvm::sys::fs::is_symlink_file(D.SysRoot + "/lib");
+      if (!UsrMerged)
+        Prefixes.push_back(D.SysRoot);
       AddDefaultGCCPrefixes(TargetTriple, Prefixes, D.SysRoot);
+      if (UsrMerged)
+        Prefixes.push_back(D.SysRoot);
     }
 
     // Then look for gcc installed alongside clang.
